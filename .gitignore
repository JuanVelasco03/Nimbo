node_modules/
__pycache__/

# datos locales de Nimbo: nada de esto debe versionarse ni compartirse
perfil_ventana/
estado/
config.json
instancia.json
sesion.json

# grabaciones (.mp4) y streams a medio unir -- binarios de usuario, no codigo
datos/

# nucleo\: el motor de captura copiado (ver CLAUDE.md, "El nucleo copiado").
# Los .py SI se versionan -- son el motor. Esto NO:
nucleo/scripts/*.exe
nucleo/scripts/*.conf
nucleo/scripts/vpn_tunel.txt
nucleo/scripts/activos.txt
nucleo/perfil/
nucleo/supervisor.log
nucleo/directo.log
nucleo/detector.log

# grabar.txt: a quien se graba (datos de usuario, no codigo). Se versiona
# grabar.template.txt en su lugar -- el detector crea grabar.txt solo en el
# primer arranque si no existe (ver detectar_m3u8.py, Detector.__init__).
nucleo/scripts/grabar.txt
nucleo/scripts/grabar.txt.bak

# empaquetado (ver specs\distribucion_instalador.md): lo que produce el
# build y lo que no se distribuye.
dist/
empaquetado/cache/
# lo inyecta construir.py --clave-publica dentro del paquete: ya solo trae
# url/anon, no la clave publica (ver nimbo/licencia_clave.py mas abajo y
# specs\07-licencia_inviolable.md)
nimbo/licencia_publica.json
# generado por construir.py justo antes de compilar con Nuitka y borrado
# apenas termina (try/finally) -- si queda colgado por un build
# interrumpido, la copia de desarrollo se pone a pedir clave; se borra a
# mano y listo (ver licencia.activa, specs\07-licencia_inviolable.md)
nimbo/licencia_clave.py
# claves de la licencia: la privada firma los tokens. Nunca a git.
empaquetado/licencia/*.local.json
